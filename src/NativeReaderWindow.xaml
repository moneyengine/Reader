<Window x:Class="LightReader.NativeReaderWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:local="clr-namespace:LightReader"
 Title="轻读 · 液态玻璃版" Icon="Assets/LightReader.ico" Width="1180" Height="800" MinWidth="820" MinHeight="600" WindowStartupLocation="CenterScreen"
 Background="Transparent" Foreground="{DynamicResource InkBrush}" FontFamily="Microsoft YaHei UI" FontSize="13"
 UseLayoutRounding="True" PreviewKeyDown="Shortcut">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="GlassTheme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border x:Name="WindowFrame" Background="{DynamicResource ShellBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="22" Padding="5">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="12,0,4,0">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
     <Button x:Name="PinButton" Content="&#xE718;" Style="{StaticResource CaptionButton}" Click="TogglePinned" AutomationProperties.Name="窗口置顶" ToolTip="窗口置顶"/>
     <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="MinimizeWindow" AutomationProperties.Name="最小化" ToolTip="最小化"/>
     <Button x:Name="MaximizeCaptionButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="MaximizeWindow" AutomationProperties.Name="最大化或还原" ToolTip="最大化 / 还原"/>
     <Button Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Click="CloseWindow" AutomationProperties.Name="关闭" ToolTip="关闭"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{StaticResource AppMark}" Width="33" Height="25"/><Button x:Name="MainMenuButton" Content="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="20" Width="38" Height="34" MinHeight="34" Padding="0" Margin="8,0,0,0" Style="{StaticResource QuietButton}" Click="ToggleMainMenu" ToolTip="主菜单" AutomationProperties.Name="主菜单" shell:WindowChrome.IsHitTestVisibleInChrome="True"/><TextBlock x:Name="CompactVoice" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="20,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="240" Visibility="Collapsed"/></StackPanel>
   </DockPanel>
   <Grid Grid.Row="1" x:Name="Workspace">
    <Grid.ColumnDefinitions><ColumnDefinition Width="78" x:Name="RailColumn"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border x:Name="NavRail" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="20" Margin="0,3,7,3">
     <DockPanel Margin="5,4">
      <StackPanel DockPanel.Dock="Bottom"><Button Style="{StaticResource NavButton}" Click="OpenServices" ToolTip="服务设置"><StackPanel><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="23" HorizontalAlignment="Center"/><TextBlock Text="设置" Margin="0,5,0,0" HorizontalAlignment="Center"/></StackPanel></Button></StackPanel>
      <StackPanel><Button x:Name="ReadNavButton" Style="{StaticResource NavButton}" Background="{DynamicResource LensBrush}" Click="BackToReading" Foreground="{DynamicResource AccentBrush}" AutomationProperties.Name="朗读"><StackPanel><TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="24" HorizontalAlignment="Center"/><TextBlock Text="朗读" Margin="0,5,0,0" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></Button>
       <Button x:Name="HistoryNavButton" Visibility="Collapsed"/>
      </StackPanel>
     </DockPanel>
    </Border>
    <Grid Grid.Column="1" Margin="1,0,5,2">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel x:Name="Header" Margin="3,2,0,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="CompactButton" Content="↗  悬浮模式" Click="Compact" ToolTip="折叠为置顶播放器"/><Button Content="•••" Click="OpenMore" Width="42" Padding="0" ToolTip="主题、字典、调试和数据管理" AutomationProperties.Name="更多功能"><Button.ContextMenu><ContextMenu><MenuItem Header="英文字典" Click="ToggleDictionary"/><MenuItem Header="深色 / 浅色" Click="ToggleTheme"/><MenuItem x:Name="TransparencyMenu" Header="减少透明度" IsCheckable="True" Click="ToggleTransparency"/><Separator/><MenuItem Header="API 调试" Click="OpenDebug"/><MenuItem Header="服务设置" Click="OpenServices"/><Separator/><MenuItem Header="导入阅读数据…" Click="ImportData"/><MenuItem Header="导出阅读数据…" Click="ExportData"/></ContextMenu></Button.ContextMenu></Button></StackPanel>
      <WrapPanel><Button x:Name="PasteButton" Click="Paste" ToolTip="Ctrl+V · 粘贴文字或图片"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77F;" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="粘贴文字/图片"/></StackPanel></Button><Button x:Name="CaptureButton" Click="Capture"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B9;" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="截图"/></StackPanel></Button><Button x:Name="ImageOcrButton" Click="ReadImage"><StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xEB9F;" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="打开图片"/></StackPanel></Button></WrapPanel>
     </DockPanel>
     <DockPanel Grid.Row="1" x:Name="OcrBar" Margin="3,0,2,8"><Button DockPanel.Dock="Right" Content="原图对照" Click="PreviewOcrImage" x:Name="ImagePreviewButton" Visibility="Collapsed" Style="{StaticResource QuietButton}"/><ComboBox x:Name="OcrEngineChoice" Visibility="Collapsed" Width="168" HorizontalAlignment="Left" AutomationProperties.Name="图片识别引擎"><ComboBoxItem Content="本机 OCR"/></ComboBox><TextBlock x:Name="SourceLabel" Text="当前阅读文档" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="13,0,0,0" TextTrimming="CharacterEllipsis"/></DockPanel>
     <Grid Grid.Row="2" x:Name="ReadingArea" Margin="3,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="0" x:Name="OriginalColumn"/><ColumnDefinition Width="0" x:Name="DictionaryColumn"/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="21">
       <Grid Margin="24,18,22,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,18"><Button x:Name="EditButton" Visibility="Collapsed"/><StackPanel><TextBlock Text="把阅读交给声音" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="TextCount" Text="朗读正文 · 0 字" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/></StackPanel></DockPanel>
        <TextBox Grid.Row="1" x:Name="Editor" TextChanged="EditorChanged" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Padding="0" FontSize="19" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="待朗读文本"/>
        <RichTextBox Grid.Row="1" x:Name="ReadingView" Visibility="Collapsed" AcceptsReturn="True" AcceptsTab="True" IsDocumentEnabled="True" BorderThickness="0" Padding="0" VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource InkBrush}" Background="Transparent" TextChanged="ReadingChanged" PreviewMouseWheel="ReadingMouseWheel" PreviewMouseRightButtonDown="ReadingRightClick" AutomationProperties.Name="朗读正文"><RichTextBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource ReadingScrollBar}"/></RichTextBox.Resources></RichTextBox>
        <StackPanel Grid.Row="1" x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="从一段文字开始" FontSize="21" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/><TextBlock Text="Ctrl+V 粘贴文字或截图，识别后即可朗读" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/></StackPanel>
       </Grid>
      </Border>
      <Border Grid.Column="1" x:Name="OriginalPanel" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="21" Margin="9,0,0,0" Padding="13" Visibility="Collapsed">
       <DockPanel><DockPanel DockPanel.Dock="Top" Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="×" Click="CloseOriginal" Style="{StaticResource QuietButton}" AutomationProperties.Name="关闭原图对照"/><TextBlock Text="原图对照" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,9,0,0"><Button Content="−" Click="ZoomOut" Padding="10,4" ToolTip="缩小图片"/><Button x:Name="ZoomLabel" Content="适应" Click="ResetZoom" Padding="9,4"/><Button Content="+" Click="ZoomIn" Padding="10,4" ToolTip="放大图片"/><Button Content="重新识别" Click="RetryOriginal" Style="{StaticResource QuietButton}"/></WrapPanel>
        <ScrollViewer x:Name="OriginalScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource CardBrush}"><Image x:Name="OriginalImage" Stretch="Uniform" VerticalAlignment="Top"/></ScrollViewer>
       </DockPanel>
      </Border>
      <Border Grid.Column="2" x:Name="DictionaryPanel" Background="{DynamicResource CardBrush}" CornerRadius="21" Margin="9,0,0,0" Visibility="Collapsed" Padding="12">
       <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" Content="关闭" Click="ToggleDictionary" Style="{StaticResource QuietButton}"/><TextBlock Text="英文字典" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel><StackPanel Grid.Row="1" Margin="0,10,0,12"><CheckBox x:Name="OnlineDictionary" Content="启用在线查询" Checked="DictionaryOptChanged" Unchecked="DictionaryOptChanged"/><TextBlock Text="在线查询会发送英文单词；双击词条可跳读。" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/><Button Content="刷新字典" Click="RefreshDictionary"/></StackPanel><ListBox Grid.Row="2" x:Name="Words" MouseDoubleClick="JumpDictionary"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,8"><TextBlock Text="{Binding Display}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Translation}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
      </Border>
     </Grid>
     <Grid Grid.Row="3" x:Name="VoicePanel" Margin="3,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="152"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions><ComboBox x:Name="Engine" Visibility="Collapsed" AutomationProperties.Name="朗读引擎"><ComboBoxItem Content="Edge 自然语音"/></ComboBox><local:VoicePicker Style="{StaticResource {x:Type ComboBox}}" Grid.Column="1" x:Name="Voice" SelectionChanged="VoiceChanged" AutomationProperties.Name="音色"/><TextBox Grid.Column="2" x:Name="VoiceSearch" Tag="搜索音色/分类" Margin="3" Background="{DynamicResource GlassBrush}" TextChanged="FilterVoices" ToolTip="搜索音色名称、语言或 ID" AutomationProperties.Name="搜索音色"/></Grid>
     <Border Grid.Row="4" x:Name="TuningPanel" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="20" Padding="12" Margin="3,0,0,8" Visibility="Collapsed">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="6,0"><TextBlock x:Name="RateLabel" Text="语速 · 1.00×"/><Slider x:Name="Rate" Minimum=".5" Maximum="2" Value="1" SmallChange=".1" Margin="0,7,16,0" ValueChanged="TuningChanged" AutomationProperties.Name="语速"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0"><TextBlock x:Name="PitchLabel" Text="音调 · 1.00"/><Slider x:Name="Pitch" Minimum=".5" Maximum="2" Value="1" Margin="0,7,16,0" ValueChanged="TuningChanged" AutomationProperties.Name="音调"/></StackPanel><StackPanel Grid.Column="2" Margin="6,0"><TextBlock x:Name="VolumeLabel" Text="音量 · 100%"/><Slider x:Name="Volume" Minimum="0" Maximum="1" Value="1" Margin="0,7,16,0" ValueChanged="TuningChanged" AutomationProperties.Name="音量"/></StackPanel><StackPanel Grid.Column="3"><StackPanel Orientation="Horizontal"><Button Content="字 −" Click="Smaller"/><Button Content="字 +" Click="Larger"/></StackPanel><Button Content="刷新音色" Click="ReloadVoices"/></StackPanel></Grid>
     </Border>
     <Border Grid.Row="5" x:Name="PlayerDock" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="27" Padding="12,7" Margin="3,0,0,0">
      <Grid x:Name="PlayerLayout"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid x:Name="ProgressPanel" Margin="2,0,15,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock x:Name="PositionLabel" DockPanel.Dock="Right" Text="0 / 0" Foreground="{DynamicResource MutedBrush}" FontSize="11"/><TextBlock x:Name="PlayerState" Text="等待朗读" FontSize="12"/></DockPanel><Slider Grid.Row="1" x:Name="Seek" Minimum="0" Maximum="1" Value="0" PreviewMouseLeftButtonUp="SeekReleased" PreviewKeyUp="SeekKey" AutomationProperties.Name="阅读进度"/></Grid>
       <StackPanel x:Name="PlaybackControls" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><ComboBox x:Name="RateChoice" Width="85" SelectedIndex="1" SelectionChanged="RatePreset" AutomationProperties.Name="语速预设"><ComboBoxItem Content="0.75×" Tag="0.75"/><ComboBoxItem Content="1.00×" Tag="1"/><ComboBoxItem Content="1.25×" Tag="1.25"/><ComboBoxItem Content="1.50×" Tag="1.5"/><ComboBoxItem Content="2.00×" Tag="2"/></ComboBox><Button Content="▶ 播放" Click="Play" x:Name="PlayButton" Style="{StaticResource PrimaryButton}" MinWidth="94" Height="43"/><Button Content="Ⅱ 暂停" Click="Pause" x:Name="PauseButton" Visibility="Collapsed" IsEnabled="False"/><Button Content="■ 停止" Click="Stop" x:Name="StopButton" IsEnabled="False"/><Button Content="↶ 从头读" Click="Restart" x:Name="RestartButton"/><Button Content="展开" Click="Compact" x:Name="ExpandButton" Visibility="Collapsed"/></StackPanel>
      </Grid>
     </Border>
     <DockPanel Grid.Row="6" x:Name="StatusPanel" Margin="9,4,3,0" MinHeight="27"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="导入" Click="ImportData" x:Name="ImportButton" Visibility="Collapsed"/><Button Content="导出" Click="ExportData" x:Name="ExportButton" Visibility="Collapsed"/><Button Content="从光标读" Click="ReadCaret" x:Name="CaretButton" Visibility="Collapsed" Style="{StaticResource QuietButton}" MinHeight="25" Padding="8,1"/></StackPanel><TextBlock x:Name="Status" Text="Windows 本机朗读 · 免费离线" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text,RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></DockPanel>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
